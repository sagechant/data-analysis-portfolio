# --- NORMALIZATION ---
print("Normalizing data...")
normalized_vimentin_intensity = []
normalized_fak_intensity = []
for i in range(num_rois):
    # Ensure list exists and has expected length before processing
    vim_data_roi = vimentin_intensity[i][:min_len] if vimentin_intensity[i] is not None else []
    fak_data_roi = fak_intensity[i][:min_len] if fak_intensity[i] is not None else []

    vim_valid_data = [v for v in vim_data_roi if v is not None and not np.isnan(v)]
    fak_valid_data = [f for f in fak_data_roi if f is not None and not np.isnan(f)]

    max_vim = max(vim_valid_data) if vim_valid_data else 1.0
    max_fak = max(fak_valid_data) if fak_valid_data else 1.0
    max_vim = max(max_vim, 1.0) # Ensure max is at least 1.0
    max_fak = max(max_fak, 1.0)

    normalized_vimentin_intensity.append([(val / max_vim) if val is not None and not np.isnan(val) else np.nan for val in vim_data_roi])
    normalized_fak_intensity.append([(val / max_fak) if val is not None and not np.isnan(val) else np.nan for val in fak_data_roi])

# --- SMOOTHING ---
print("Smoothing data...")
def smooth(data, window):
    """Applies convolution smoothing, handling NaNs by interpolation."""
    if not data: # Handle empty list case
        return []
    data_arr = np.array(data, dtype=float) # Ensure float type
    nan_mask = np.isnan(data_arr)

    # Interpolate NaNs before smoothing if possible
    try:
        if np.any(nan_mask) and not np.all(nan_mask): # Check if there are NaNs and also some valid numbers
             indices = np.arange(len(data_arr))
             # Only interpolate using valid (non-NaN) points
             valid_indices = indices[~nan_mask]
             valid_data = data_arr[~nan_mask]
             if len(valid_indices) > 0: # Need at least one valid point to interpolate
                 data_arr[nan_mask] = np.interp(indices[nan_mask], valid_indices, valid_data)
             else: # All values were NaN
                  data_arr.fill(0) # Fill with 0 if no valid points exist
        elif np.all(nan_mask): # Handle case where all values are NaN
             data_arr.fill(0)
    except Exception as e:
         # If interpolation fails, just replace NaNs with 0 for convolution
         # print(f"Warning: Interpolation failed during smoothing: {e}. Replacing NaNs with 0.")
         data_arr[np.isnan(data_arr)] = 0 # Ensure any remaining NaNs become 0

    # Apply convolution
    smoothed_data = np.convolve(data_arr, np.ones(window)/window, mode='same')

    # Optionally, re-apply NaNs if you don't want interpolated values in the output
    # smoothed_data[nan_mask] = np.nan

    return smoothed_data.tolist()


