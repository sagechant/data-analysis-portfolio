        plt.plot(smooth(fak_int_plot, smooth_window), label='FAK', color='green')
        plt.title(f'ROI {i+1}: Intensity & Area Over Time')
        plt.ylabel('Smoothed Intensity')
        plt.legend()
        plt.grid(True)

        plt.subplot(3, 1, 2)
        plt.plot(smooth(norm_vim_plot, smooth_window), label='Norm. Vimentin', color='red')
        plt.plot(smooth(norm_fak_plot, smooth_window), label='Norm. FAK', color='green')
        plt.ylabel('Normalized Intensity (0-1)')
        plt.legend()
        plt.grid(True)

        plt.subplot(3, 1, 3)
        plt.plot(smooth(fak_area_plot, smooth_window), label='FAK Area', color='blue')
        plt.xlabel('Frame')
        plt.ylabel('Smoothed Area (Pixels)')
        plt.legend()
        plt.grid(True)

        plt.tight_layout()
        plt.show() # Display the plot
