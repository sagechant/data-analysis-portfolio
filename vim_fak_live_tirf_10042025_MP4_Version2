    # Initialize global variables needed for drawing
    rois_being_drawn = [] # Reset list for this selection session
    frame_display_base = frame.copy()
    frame_copy_dynamic = frame.copy()

    # Define window name globally or ensure it's accessible
    window_name_roi = "Define ROIs (Drag Mouse; ENTER/s=Save, ESC/q=Cancel)"
    cv2.namedWindow(window_name_roi)

    # Attach the callback function (now defined globally) to the window
    cv2.setMouseCallback(window_name_roi, mouse_callback_roi_user)

    print("\n--- Interactive ROI Selection ---")
