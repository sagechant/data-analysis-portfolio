    print("Error: ROI list is empty after selection/definition step.")
    sys.exit()

vimentin_intensity = [[] for _ in range(num_rois)]
fak_intensity = [[] for _ in range(num_rois)]
fak_area = [[] for _ in range(num_rois)]
print(f"Initialized data storage for {num_rois} ROIs.")

# --- PROCESSING VIDEO FRAMES ---
print("Starting frame processing loop...")
frame_counter = 0
while True:
    ret, frame = cap.read()
    if not ret:
        # print(f"\nEnd of video or error reading frame after {frame_counter} frames.") # Less verbose end
        break

    frame_counter += 1

    for i, roi_coords in enumerate(rois):
        x, y, w, h = roi_coords # Unpack ROI coordinates
        # Validate ROI bounds
        x, y = max(0, x), max(0, y)
        w = min(w, frame_width - x)
        h = min(h, frame_height - y)

        if w <= 0 or h <= 0:
            vimentin_intensity[i].append(np.nan)
            fak_intensity[i].append(np.nan)
            fak_area[i].append(0)
            continue

        roi_frame = frame[y:y+h, x:x+w]
        if roi_frame.size == 0:
             vimentin_intensity[i].append(np.nan)
             fak_intensity[i].append(np.nan)
             fak_area[i].append(0)
             continue

        # Channel processing (BGR order: Blue=0, Green=1, Red=2)
        red = roi_frame[:, :, 2]   # Vimentin
        green = roi_frame[:, :, 1] # FAK
        vimentin_intensity[i].append(np.mean(red) if red.size > 0 else np.nan)
        fak_intensity[i].append(np.mean(green) if green.size > 0 else np.nan)

        # FAK area calculation
        if green.size > 0:
            try:
                # Ensure green channel is 8-bit single channel for adaptiveThreshold
                if green.dtype != np.uint8:
                    # Attempt conversion if possible, might need normalization first
                     green_norm = cv2.normalize(green, None, 0, 255, cv2.NORM_MINMAX)
                     # Check if normalization resulted in a valid array before converting type
                     if green_norm is not None and green_norm.size > 0:
                         green_uint8 = green_norm.astype(np.uint8)
                     else:
                         raise ValueError("Normalization failed or resulted in empty array")
                else:
                    green_uint8 = green # Already uint8

                thresh = cv2.adaptiveThreshold(green_uint8, 255, adaptive_threshold_method,
                                                cv2.THRESH_BINARY_INV, adaptive_threshold_block_size,
                                                adaptive_threshold_constant)
                fak_area[i].append(np.sum(thresh == 255))
            except (cv2.error, ValueError) as e:
                # print(f"Warning: Error during adaptiveThreshold on frame {frame_counter}, ROI {i+1}: {e}")
                fak_area[i].append(0)
        else:
             fak_area[i].append(0)

    if frame_counter % 100 == 0:
        print(f"Processed frame {frame_counter}...")


print(f"Finished processing {frame_counter} frames.")
