try:
    import cv2
except ImportError:
    raise ImportError("The cv2 module is not installed. Install it by running 'pip install opencv-python'.")
import numpy as np
import matplotlib.pyplot as plt
from skimage import filters, measure
from scipy.stats import pearsonr
import pandas as pd
import os
import subprocess

# Function to install required packages
def install_packages():
    """
    Installs all necessary Python packages for the script.
    """
    packages = ["opencv-python", "numpy", "matplotlib", "scikit-image", "scipy", "pandas"]
    for package in packages:
        subprocess.check_call(["pip", "install", package])

# Function to analyze video for colocalization and intensity profiles
def analyze_video(video_path, scale_factor=0.25, frame_limit=None, output_dir=r"C:\Users\Arun\Downloads\PhD\Manuscript\TIRF LIVE IMAGING\Python Analysis Results"):
    """
    Analyzes a video for colocalization and intensity profiles.

    Parameters:
        video_path (str): Path to the video file.
        scale_factor (float): Scaling factor for downsampling frames.
        frame_limit (int): Limit on the number of frames to process. None for all frames.
        output_dir (str): Directory to save output files.

    Output:
        Saves CSV and PNG files for the analysis in the output directory.
    """
    os.makedirs(output_dir, exist_ok=True)

    # Check write permissions for output directory
    if not os.access(output_dir, os.W_OK):
        raise PermissionError(f"Write permission denied for directory: {output_dir}")

    # Open the video file
    video_capture = cv2.VideoCapture(video_path)
    fps = int(video_capture.get(cv2.CAP_PROP_FPS))
    total_frames = int(video_capture.get(cv2.CAP_PROP_FRAME_COUNT))
    print(f"Processing video: {video_path}\nTotal frames: {total_frames}\nFPS: {fps}")

    # Initialize lists for results
    correlation_values = []
    green_intensity = []
    magenta_intensity = []

    frame_idx = 0

    while True:
        ret, frame = video_capture.read()
        if not ret or (frame_limit and frame_idx >= frame_limit):
            break

        # Downsample the frame
        frame_resized = cv2.resize(frame, None, fx=scale_factor, fy=scale_factor, interpolation=cv2.INTER_AREA)
        # Convert frame to RGB
        frame_rgb = cv2.cvtColor(frame_resized, cv2.COLOR_BGR2RGB)
        # Extract green and magenta channels
        green_channel = frame_rgb[:, :, 1]
        magenta_channel = frame_rgb[:, :, 2]

        # Threshold to binary using Otsu's method
        green_binary = green_channel > filters.threshold_otsu(green_channel)
        magenta_binary = magenta_channel > filters.threshold_otsu(magenta_channel)

        # Calculate Pearson correlation
        correlation = pearsonr(green_binary.flatten(), magenta_binary.flatten())[0]
        correlation_values.append(correlation)

        # Calculate mean intensity
        green_intensity.append(np.mean(green_channel))
        magenta_intensity.append(np.mean(magenta_channel))

        frame_idx += 1

    video_capture.release()

    # Save results for colocalization
    correlation_df = pd.DataFrame({
        "Frame": range(len(correlation_values)),
        "Pearson Correlation": correlation_values
    })
    correlation_df.to_csv(os.path.join(output_dir, "correlation_analysis.csv"), index=False)

    # Save results for intensity profiles
    intensity_df = pd.DataFrame({
        "Frame": range(len(green_intensity)),
        "Green Intensity": green_intensity,
        "Magenta Intensity": magenta_intensity
    })
    intensity_df.to_csv(os.path.join(output_dir, "intensity_analysis.csv"), index=False)

    # Generate plots for the analysis
    plt.figure()
    plt.plot(correlation_df["Frame"], correlation_df["Pearson Correlation"], color="blue")
    plt.xlabel("Frame")
    plt.ylabel("Pearson Correlation (Colocalization)")
    plt.title("Colocalization Analysis")
    plt.savefig(os.path.join(output_dir, "colocalization_analysis.png"))

    plt.figure()
    plt.plot(intensity_df["Frame"], intensity_df["Green Intensity"], label="Focal Adhesions (Green)", color="green")
    plt.plot(intensity_df["Frame"], intensity_df["Magenta Intensity"], label="Vimentin (Magenta)", color="magenta")
    plt.xlabel("Frame")
    plt.ylabel("Mean Intensity")
    plt.title("Intensity Profile Comparison")
    plt.legend()
    plt.savefig(os.path.join(output_dir, "intensity_profile_comparison.png"))

    print(f"Analysis completed. Results saved to: {output_dir}")

# Install packages
install_packages()

